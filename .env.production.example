# Copy to .env on the server: cp .env.production.example .env && nano .env

# --- Domains (used at build time for frontend/admin) ---
# Leave empty: /api is proxied on app and admin hosts (recommended).
# Or set https://api.example.com if you call API on a separate subdomain.
VITE_API_URL=

# Edit nginx/nginx.prod.conf: app / api / admin hostnames

# --- Security (generate: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_long_random_admin_key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_min_8_chars
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_USER=postgres
POSTGRES_DB=aisearch

# --- MAX bot ---
BOT_TOKEN=your_max_bot_token
SKIP_INIT_DATA_VALIDATION=false

# --- App ---
ENVIRONMENT=production
DEBUG=false
# Обязательно все три хоста — иначе админка не загрузит /api/admin/users
CORS_ORIGINS=https://app.example.com,https://api.example.com,https://admin.example.com
# Share guest_session cookie between app.* and api.* (leading dot)
COOKIE_DOMAIN=.example.com

# --- Yandex Cloud (Search + YandexGPT Lite/Pro) — см. docs/YANDEX_SETUP.md ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# gpt://{folder}/{model}/{version}
YANDEX_GPT_LITE_MODEL=yandexgpt-lite/latest
YANDEX_GPT_PRO_MODEL=yandexgpt/latest
# YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search

# --- Anthropic Claude (optional LLM in admin; search stays Yandex) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LITE=claude-3-5-haiku-latest
ANTHROPIC_MODEL_PRO=claude-sonnet-4-20250514

# --- YooKassa (optional) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Limits ---
GUEST_SEARCHES_PER_DAY=5
FREE_SEARCHES_PER_DAY=10
PRO_SEARCHES_PER_DAY=200
GLOBAL_YANDEX_REQUESTS_PER_DAY=5000
