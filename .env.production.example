# Copy to .env on the server: cp .env.production.example .env && nano .env

# --- Domains (used at build time for frontend/admin) ---
# API URL must be HTTPS in production (MAX requires HTTPS for miniapp)
VITE_API_URL=https://api.example.com

# Edit nginx/nginx.prod.conf: app / api / admin hostnames

# --- Security (generate: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_long_random_admin_key
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_USER=postgres
POSTGRES_DB=aisearch

# --- MAX bot ---
BOT_TOKEN=your_max_bot_token
SKIP_INIT_DATA_VALIDATION=false

# --- App ---
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://app.example.com,https://api.example.com

# --- Yandex Cloud ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# --- YooKassa (optional) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Limits ---
FREE_SEARCHES_PER_DAY=10
PRO_SEARCHES_PER_DAY=200
GLOBAL_YANDEX_REQUESTS_PER_DAY=5000
