# Copy to .env on the server: cp .env.production.example .env && nano .env

# --- Domains (used at build time for frontend/admin) ---
# Leave empty: /api is proxied on app and admin hosts (recommended).
# Or set https://api.example.com if you call API on a separate subdomain.
VITE_API_URL=
# Canonical public URL for copy/share attribution (build-time)
VITE_PUBLIC_URL=https://glosix.ru

# Edit nginx/nginx.prod.conf: app / api / admin hostnames

# --- Security (generate: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_long_random_admin_key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_min_8_chars
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_USER=postgres
POSTGRES_DB=aisearch

# --- MAX bot ---
BOT_TOKEN=your_max_bot_token
# Deeplink на бота (без ?startapp): https://max.ru/id1234567890_bot
VITE_MAX_BOT_URL=https://max.ru/your_bot_username
# Тот же URL бота для return_url ЮKassa после оплаты в MAX (startapp=pay_ok)
MAX_BOT_URL=https://max.ru/your_bot_username
SKIP_INIT_DATA_VALIDATION=false
# Защита POST /api/bot/webhook (заголовок X-Webhook-Secret или ?secret=)
MAX_BOT_WEBHOOK_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# --- App ---
ENVIRONMENT=production
DEBUG=false
# Обязательно все три хоста — иначе админка не загрузит /api/admin/users
CORS_ORIGINS=https://glosix.ru,https://www.glosix.ru,https://api.glosix.ru,https://admin.glosix.ru,https://app.glosix.ru
# Share guest_session cookie between site and api.* (leading dot)
COOKIE_DOMAIN=.glosix.ru

# --- Yandex Cloud (Search + YandexGPT Lite/Pro) — см. docs/YANDEX_SETUP.md ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# gpt://{folder}/{model}/{version}
YANDEX_GPT_LITE_MODEL=yandexgpt-lite/latest
YANDEX_GPT_PRO_MODEL=yandexgpt/latest
# Vision (Alice AI VLM) — те же YANDEX_* ключи; aliceai-vlm в API пока нет — fallback gemma:
YANDEX_ALICE_VLM_MODEL=aliceai-vlm/latest
YANDEX_VISION_GEMMA_MODEL=gemma-3-27b-it
YANDEX_VISION_ALICE_FIRST=false
YANDEX_VISION_IMAGE_MAX_SIDE=1536
YANDEX_VISION_IMAGE_MAX_BYTES=900000
YANDEX_AI_STUDIO_BASE_URL=https://ai.api.cloud.yandex.net/v1
# YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search

# --- Anthropic Claude (optional LLM in admin; search stays Yandex) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LITE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PRO=claude-sonnet-4-6
# Если curl с VPS даёт 403 Request not allowed — прокси в поддерживаемом регионе (EU/US):
# ANTHROPIC_HTTP_PROXY=http://user:pass@host:port

# --- DeepSeek (optional LLM in admin; search stays Yandex) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_LITE=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_HTTP_PROXY=http://user:pass@host:port

# --- Google Gemini / Nano Banana 2 (image generation) ---
# API key from https://aistudio.google.com — requires billing enabled
# Admin: Settings → Image Gen Provider → Nano Banana 2
GOOGLE_API_KEY=
# HTTP(S) proxy for Google Gemini — needed if server is in a geo-restricted region (e.g. RU)
# Same pattern as ANTHROPIC_HTTP_PROXY. Example: http://user:pass@proxy-host:3128
GOOGLE_HTTP_PROXY=

# --- GigaChat (optional LLM + vision; scope PERS for personal API) ---
# Ключ авторизации Base64 из developers.sber.ru → «Авторизационные данные» (не Client Secret отдельно)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_LITE=GigaChat-2
GIGACHAT_MODEL_PRO=GigaChat-2-Pro
# SSL: без корня НУЦ Минцифры platform-api2.max.ru не работает — см. docs/GIGACHAT_SETUP.md
# GIGACHAT_CA_BUNDLE_FILE=/opt/aisearch/certs/russian_trusted_root_ca.pem
# MAX_CA_BUNDLE_FILE=/opt/aisearch/certs/russian_trusted_root_ca.pem
# MAX_BOT_API_BASE=https://platform-api2.max.ru
# GIGACHAT_VERIFY_SSL_CERTS=false

# --- YooKassa (optional) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ: 1 = без НДС; tax_system_code — если требует кабинет ЮKassa
# YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM_CODE=1
PUBLIC_WEB_URL=https://glosix.ru

# --- Limits ---
GUEST_SEARCHES_PER_DAY=5
FREE_SEARCHES_PER_DAY=10
PRO_SEARCHES_PER_DAY=200
PRO_PRICE_RUB=299
# GIGACHAT_CA_BUNDLE_FILE=/path/to/russian_trusted_root_ca.cer

# Perplexity Sonar — встроенный поиск; при llm_provider=perplexity Yandex Search не вызывается
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_LITE=sonar
PERPLEXITY_MODEL_PRO=sonar-pro

GLOBAL_YANDEX_REQUESTS_PER_DAY=5000
