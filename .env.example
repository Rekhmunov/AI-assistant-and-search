# Backend
DEBUG=true
ENVIRONMENT=development
SKIP_INIT_DATA_VALIDATION=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aisearch
REDIS_URL=redis://redis:6379/0

BOT_TOKEN=
JWT_SECRET=dev-secret-change-in-production
ADMIN_API_KEY=dev-admin-key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-8chars-min

YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_GPT_LITE_MODEL=yandexgpt-lite/latest
YANDEX_GPT_PRO_MODEL=yandexgpt/latest

# Claude (опционально; выбор LLM в админке → anthropic_claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LITE=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_PRO=claude-3-5-sonnet-20241022

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

FREE_SEARCHES_PER_DAY=10
PRO_SEARCHES_PER_DAY=200
