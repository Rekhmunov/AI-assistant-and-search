# Backend
DEBUG=true
ENVIRONMENT=development
SKIP_INIT_DATA_VALIDATION=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aisearch
REDIS_URL=redis://redis:6379/0

BOT_TOKEN=
JWT_SECRET=dev-secret-change-in-production
ADMIN_API_KEY=dev-admin-key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-8chars-min

YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_GPT_LITE_MODEL=yandexgpt-lite/latest
YANDEX_GPT_PRO_MODEL=yandexgpt/latest

# Claude (опционально; выбор LLM в админке → anthropic_claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LITE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PRO=claude-sonnet-4-6

# DeepSeek (опционально; выбор LLM в админке → deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_LITE=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# GigaChat (опционально; LLM и vision по умолчанию в админке → gigachat)
# Authorization key в Base64 (личный кабинет Sber AI / GigaChat API)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_LITE=GigaChat-2
GIGACHAT_MODEL_PRO=GigaChat-2-Pro
# GIGACHAT_VERIFY_SSL_CERTS=false
# GIGACHAT_CA_BUNDLE_FILE=/path/to/russian_trusted_root_ca.cer

# Perplexity Sonar (опционально; LLM в админке → perplexity; Yandex Search не используется)
# Lite = sonar, Pro = sonar-pro (docs.perplexity.ai/docs/sonar/models)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_LITE=sonar
PERPLEXITY_MODEL_PRO=sonar-pro
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_SEARCH_RECENCY_FILTER=month
# PERPLEXITY_RETURN_RELATED_QUESTIONS=true

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ: 1 = без НДС (по умолчанию)
# YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM_CODE=1
PUBLIC_WEB_URL=https://glosix.ru

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

FREE_SEARCHES_PER_DAY=10
PRO_SEARCHES_PER_DAY=200
PRO_PRICE_RUB=299

# Скорость RAG (низкий риск для качества; см. /api/health → features)
PAGE_CACHE_ENABLED=true
QUERY_URL_INDEX_ENABLED=true
PAGE_FETCH_MAX_PAGES=3
PAGE_FETCH_SKIP_RICH_SNIPPET_CHARS=1400
FOLLOW_UPS_DEFERRED=true
FOLLOW_UPS_POST_DONE_TIMEOUT_SEC=4.0
