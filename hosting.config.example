# Скопируйте в hosting.config и заполните перед настройкой:
#   cp hosting.config.example hosting.config && nano hosting.config
#   bash scripts/configure-hosting.sh

# Базовый домен (без api/admin)
DOMAIN=glosix.ru

# Основной сайт / миниапп (MAX). Можно apex или app.DOMAIN.
APP_HOST=glosix.ru
# Доп. имена через пробел (www и т.п.)
APP_HOST_ALIASES=www.glosix.ru
# Старый поддомен — редирект на APP_HOST (оставьте пустым, если не нужен)
LEGACY_APP_HOST=app.glosix.ru

# API и админка
API_HOST=api.glosix.ru
ADMIN_HOST=admin.glosix.ru

# Порт внутреннего Docker-nginx (ISPmanager проксирует сюда)
PROXY_PORT=8080

# Репозиторий для deploy.sh (если клонируете с GitHub)
REPO_URL=https://github.com/Rekhmunov/AI-assistant-and-search.git
GIT_BRANCH=main

# Каталог установки на сервере
APP_DIR=/opt/aisearch

# MAX bot (можно заполнить позже в .env)
# BOT_TOKEN=
# Ссылка на бота MAX (кнопка «Открыть в MAX» на сайте)
# VITE_MAX_BOT_URL=https://max.ru
